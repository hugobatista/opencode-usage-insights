{
  "name": "opencode-usage-insights",
  "version": "0.2.0",
  "description": "OpenCode V2 plugin that puts per-turn and per-session cost back in the TUI and OpenCode Desktop \u2014 charged cost, list-price estimates, tokens, prompt-cache reuse, latency and local history in a live line, sidebar, header badge and /usage panel.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Hugo Batista",
    "url": "https://github.com/hugobatista"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugobatista/opencode-usage-insights.git"
  },
  "homepage": "https://github.com/hugobatista/opencode-usage-insights#readme",
  "bugs": {
    "url": "https://github.com/hugobatista/opencode-usage-insights/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tui",
    "telemetry",
    "usage-statistics",
    "sqlite",
    "prompt-cache",
    "observability",
    "token-usage",
    "cost-tracking",
    "cost-visibility",
    "cost-estimation",
    "local-first",
    "bun",
    "typescript",
    "opencode-desktop",
    "desktop",
    "electron",
    "gui",
    "rpc"
  ],
  "engines": {
    "opencode": ">=2.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.gui.json",
    "build": "bun run scripts/build.ts",
    "demo": "bun run scripts/demo.ts",
    "docs:images": "bun run scripts/screenshot.ts",
    "report": "bun run scripts/report.ts",
    "prepublishOnly": "bun run typecheck && bun run build && bun test && bun run check:package",
    "bench": "bun run scripts/bench.ts",
    "check:platform": "bun run scripts/check-platform.ts",
    "build:gui": "vite build",
    "dev:gui": "vite build --watch",
    "check:package": "bun run scripts/check-package.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.4.2",
    "@opencode/theme": ">=2.4.2",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "effect": ">=4.1.0",
    "solid-js": ">=1.9.12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@opencode/plugin": "2.4.2",
    "@opencode/theme": "2.4.2",
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.9",
    "@types/bun": "^1.4.1",
    "@types/node": "^24.0.0",
    "effect": "4.1.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0",
    "vite": "^7",
    "vite-plugin-solid": "^2.11.17"
  }
}
